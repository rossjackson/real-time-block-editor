{
  "name": "real-time-block-editor",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "typecheck": "nx run-many -t typecheck --projects=backend,frontend",
    "lint": "eslint .",
    "build": "nx run-many -t build --projects=backend,frontend",
    "build:backend": "nx build backend",
    "build:frontend": "nx build frontend",
    "serve:frontend": "nx serve frontend",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "ws": "8.20.0",
    "y-websocket": "2.1.0",
    "yjs": "13.6.30"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "css-loader": "7.1.4",
    "dotenv-webpack": "9.0.0",
    "eslint": "10.2.1",
    "html-webpack-plugin": "5.6.7",
    "nx": "22.6.5",
    "prettier": "3.8.3",
    "style-loader": "4.0.0",
    "ts-loader": "9.5.7",
    "ts-node": "10.9.2",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.0",
    "webpack": "5.106.2",
    "webpack-cli": "7.0.2",
    "webpack-dev-server": "5.2.3"
  }
}
